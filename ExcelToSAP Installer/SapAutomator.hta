        <!-- Group: Master Data -->
        <span class="group-title" onclick="ToggleVisibility 'grpMD', 'c6'"><span id="c6" class="caret caret-right"></span>Master Data</span>
        <ul id="grpMD" class="hidden">
            <!-- Menu: Equipment -->
